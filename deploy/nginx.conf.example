# Beispiel-Konfiguration – digest.example.org durch deine Domain ersetzen
# /etc/nginx/sites-available/digest.example.org
# Aktivieren: ln -s /etc/nginx/sites-available/digest.example.org /etc/nginx/sites-enabled/
# Zertifikat:  certbot --nginx -d digest.example.org   (oder deine bestehende Lösung)

server {
    listen 80;
    listen [::]:80;
    server_name digest.example.org;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name digest.example.org;

    ssl_certificate     /etc/letsencrypt/live/digest.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/digest.example.org/privkey.pem;

    # Nur der Feed (und der Health-Check) werden durchgereicht, alles andere 404.
    location ~ ^/[A-Za-z0-9_-]+/feed\.xml$ {
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # Klick-Zähler /<token>/r/<id>, 👍/👎 /<token>/v/<id>/up|down, Pixel-Messung /<token>/p/<id>.gif
    # (Anführungszeichen sind nötig, weil der Ausdruck {…} enthält)
    location ~ "^/[A-Za-z0-9_-]+/(r/[A-Za-z0-9_-]{1,64}|v/[A-Za-z0-9_-]{1,64}/(up|down)|p/[A-Za-z0-9_-]{1,64}\.gif)$" {
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host $host;
        proxy_set_header User-Agent $http_user_agent;
    }
    # Status-Seite mit Logs und Berichten: /<token>/status, /<token>/status.json, /<token>/status/…
    # Zusätzlich mit Passwort geschützt – sie zeigt dein Leseverhalten, und die Feed-URL (mit Token)
    # wandert leichter weiter als gedacht. Passwortdatei anlegen (Benutzername frei wählbar):
    #   printf "digest:$(openssl passwd -apr1)\n" | sudo tee /etc/nginx/feed-digestive.htpasswd
    location ~ ^/[A-Za-z0-9_-]+/status(\.json|/.*)?$ {
        auth_basic           "feed-digestive";
        auth_basic_user_file /etc/nginx/feed-digestive.htpasswd;
        proxy_pass http://127.0.0.1:8087;
        proxy_set_header Host $host;
    }
    location = /healthz { proxy_pass http://127.0.0.1:8087; }
    location / { return 404; }

    # Feed-Abrufe nicht mit geheimem Pfad ins Log schreiben
    access_log off;
}
