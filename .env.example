# ======================================================================
# Miniflux
# ======================================================================
# Basis-URL deiner Miniflux-Instanz (ohne /v1)
MINIFLUX_URL=https://miniflux.example.de
# Miniflux → Einstellungen → API-Schlüssel → Neuen Schlüssel erstellen
MINIFLUX_API_TOKEN=

# Zeitraum für den ersten Lauf (danach: alles seit dem letzten Lauf)
LOOKBACK_HOURS=24
# Obergrenze, wie viele neue Einträge pro Lauf betrachtet werden
MAX_ENTRIES=400
# true = nur ungelesene Einträge berücksichtigen
ONLY_UNREAD=false
# Optional: nur diese Kategorien (IDs, kommagetrennt) / diese Feeds ausschließen
CATEGORY_IDS=
EXCLUDE_FEED_IDS=
# Mit Stern markierte Miniflux-Artikel zusätzlich als Interessensignal nutzen
USE_MINIFLUX_STARRED=true

# ======================================================================
# LLM – zwei Stufen: günstiges Modell bewertet alles, gutes Modell schreibt Auszüge
# Anbieter: anthropic | openai | mistral | openrouter | gemini | ollama | custom
# ======================================================================
SCORING_PROVIDER=anthropic
SCORING_MODEL=claude-haiku-5-5
SUMMARY_PROVIDER=anthropic
SUMMARY_MODEL=claude-sonnet-5-5

# Nur den Key des genutzten Anbieters eintragen
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Ollama auf dem Host (Standard) oder anderswo; Key meist leer
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Beliebiger OpenAI-kompatibler Endpunkt (LM Studio, vLLM, LiteLLM, IONOS AI …)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Beispiele (z. B. Mistral, in der EU gehostet):
#   SCORING_PROVIDER=mistral   SCORING_MODEL=mistral-small-latest
#   SUMMARY_PROVIDER=mistral   SUMMARY_MODEL=mistral-medium-latest
# Lokal mit Ollama:
#   SCORING_PROVIDER=ollama    SCORING_MODEL=qwen3:8b

SCORING_BATCH_SIZE=40
# Wie viele deiner gespeicherten Beispiele mitgeschickt werden (mehr = genauer, teurer)
EXAMPLES_IN_PROMPT=120

# ======================================================================
# Auswahl & Ausgabe
# ======================================================================
TOP_N=10
# Mindestwert 0–10; an schwachen Tagen kommen dann eben weniger Artikel
MIN_SCORE=6
OUTPUT_LANGUAGE=Deutsch
# daily = ein Feed-Eintrag pro Tag mit allen Artikeln
# items = jeder ausgewählte Artikel ist ein eigener Feed-Eintrag
FEED_MODE=daily
FEED_TITLE=Mein Tages-Digest
KEEP_DAYS=30

# ======================================================================
# Zeitplan & Veröffentlichung
# ======================================================================
DIGEST_TIME=06:30
TZ=Europe/Berlin
RUN_ON_START=false
PUBLIC_URL=https://rss.js32.de
# Geheimer Pfadteil -> Feed liegt unter PUBLIC_URL/FEED_TOKEN/feed.xml
# Erzeugen z. B. mit:  openssl rand -hex 16
FEED_TOKEN=
