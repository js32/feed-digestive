# ======================================================================
# Quelle: miniflux (native API) | greader (Google-Reader-API)
# ======================================================================
SOURCE=miniflux

# --- Google Reader API: FreshRSS, Inoreader, The Old Reader, BazQux, Miniflux, …
# Basis-URL, unter der /accounts/ClientLogin und /reader/api/0/ liegen:
#   FreshRSS:        https://freshrss.example.de/api/greader.php
#   Miniflux:        https://miniflux.example.de   (Einstellungen → Integrationen → Google Reader)
#   Inoreader:       https://www.inoreader.com     (+ GREADER_APP_ID / GREADER_APP_KEY)
#   The Old Reader:  https://theoldreader.com
#   BazQux:          https://bazqux.com
GREADER_URL=
GREADER_USER=
# API-Passwort (bei FreshRSS im Profil gesondert festlegen, nicht das Login-Passwort)
GREADER_PASSWORD=
GREADER_APP_ID=
GREADER_APP_KEY=
# Optional: nur diese Ordner/Labels (kommagetrennt), sonst alle Artikel
GREADER_LABELS=

# --- Miniflux (native API)
# Basis-URL deiner Miniflux-Instanz (ohne /v1)
MINIFLUX_URL=https://miniflux.example.de
# Miniflux → Einstellungen → API-Schlüssel → Neuen Schlüssel erstellen
MINIFLUX_API_TOKEN=

# Welche Artikel kommen in Frage?
#   unread = alle ungelesenen (neueste zuerst, höchstens MAX_ENTRIES). Bereits bewertete Artikel
#            werden nicht neu bewertet, schon gezeigte kommen nicht nochmal in den Digest.
#   new    = nur Artikel, die seit dem letzten Lauf neu dazugekommen sind
SELECT_FROM=unread
# Ungelesene älter als so viele Tage ignorieren (0 = kein Limit)
UNREAD_MAX_AGE_DAYS=30
# Nur für SELECT_FROM=new: Zeitraum für den ersten Lauf
LOOKBACK_HOURS=24
# Obergrenze, wie viele neue Einträge pro Lauf betrachtet werden
MAX_ENTRIES=400
# Nur für SELECT_FROM=new: true = davon nur die ungelesenen
ONLY_UNREAD=false
# Optional (Miniflux): nur diese Kategorie-IDs / (beide) diese Feed-IDs ausschließen
# Google Reader: Feed-IDs haben die Form feed/https://example.org/rss
CATEGORY_IDS=
EXCLUDE_FEED_IDS=
# Mit Stern markierte Miniflux-Artikel zusätzlich als Interessensignal nutzen
USE_MINIFLUX_STARRED=true

# ======================================================================
# LLM – zwei Stufen: günstiges Modell bewertet alles, gutes Modell schreibt Auszüge
# Anbieter: anthropic | openai | mistral | openrouter | gemini | ollama | custom
#           (SCORING_PROVIDER zusätzlich: none = nur Laya-Wert, siehe unten)
# ======================================================================
SCORING_PROVIDER=anthropic
SCORING_MODEL=claude-haiku-5-5
SUMMARY_PROVIDER=anthropic
SUMMARY_MODEL=claude-sonnet-5-5

# Nur den Key des genutzten Anbieters eintragen
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Ollama auf dem Host (Standard) oder anderswo; Key meist leer
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Beliebiger OpenAI-kompatibler Endpunkt (LM Studio, vLLM, LiteLLM, IONOS AI …)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Beispiele (z. B. Mistral, in der EU gehostet):
#   SCORING_PROVIDER=mistral   SCORING_MODEL=mistral-small-latest
#   SUMMARY_PROVIDER=mistral   SUMMARY_MODEL=mistral-medium-latest
# Lokal bewerten (Ollama-Container, siehe docker-compose.yml), Auszüge per API:
#   SCORING_PROVIDER=ollama    SCORING_MODEL=qwen3.5:4b
#   OLLAMA_BASE_URL=http://ollama:11434/v1
#   SCORING_BATCH_SIZE=15      EXAMPLES_IN_PROMPT=40
#   SUMMARY_PROVIDER=mistral   SUMMARY_MODEL=mistral-medium-latest
# Zeitlimit pro LLM-Aufruf in Sekunden (Standard: 900 lokal, 120 API)
# LLM_TIMEOUT=900

# ======================================================================
# Optional: lokaler Vorfilter mit Laya (kleines Entscheidungsmodell, läuft auf CPU)
# Siebt alle neuen Artikel vor, nur die besten PREFILTER_KEEP gehen weiter ans LLM.
# Fragen/Gewichte: config/laya_questions.json
# Image dafür bauen mit:  WITH_LAYA=1 docker compose up -d --build
# ======================================================================
PREFILTER=none
# PREFILTER=laya
PREFILTER_KEEP=40
# Mindestwert (0–10) nach Laya, darunter fliegt ein Artikel sofort raus
PREFILTER_MIN=2.0
# auto = Sprache je Artikel erkennen (Englisch -> english, sonst multilingual) – empfohlen
# multilingual | english = ein Modell fest für alle Artikel
LAYA_MODEL=auto
LAYA_MAX_LEN=1024
LAYA_BATCH_SIZE=8
# CPU-Threads für Laya (0 = so viele Kerne, wie der Container nutzen darf)
LAYA_THREADS=0
# Fortschritt loggen und Zwischenstand sichern alle N Artikel
LAYA_CHUNK=32
# Ganz ohne LLM bewerten: SCORING_PROVIDER=none (dann zählt der Laya-Wert, MIN_SCORE ~4)

# ======================================================================
# Optional: lokale Embeddings (fastembed/ONNX, kein PyTorch, Modell ca. 220 MB in data/)
# Erkennt dieselbe Geschichte aus mehreren Quellen und zeigt, welchem deiner Stern-Artikel
# ein Vorschlag ähnelt. Läuft komplett lokal.
# Image dafür bauen mit:  WITH_EMBEDDINGS=1 docker compose up -d --build
# ======================================================================
EMBEDDINGS=false
# mehrsprachig, erkennt auch eine englische und eine deutsche Meldung als dieselbe Geschichte
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Ab dieser Ähnlichkeit (0–1) gelten zwei Artikel als dieselbe Geschichte, nur der bessere bleibt
DEDUP_SIMILARITY=0.75
# "Ähnlich zu deinem Stern-Artikel …" ab dieser Ähnlichkeit anzeigen (0 = aus).
# Jeder Vergleich steht mit Wert im Log ("Stern-Vergleich 0.61: …") – danach justieren.
SIMILAR_MIN=0.55

# ======================================================================
# Lernen aus Klicks und Sternen (alles lokal in data/)
# ======================================================================
# Links im Digest laufen über PUBLIC_URL/FEED_TOKEN/r/<id> und werden gezählt
TRACK_CLICKS=true
# Mit Laya: Gewichte automatisch aus Klicks/Sternen lernen
LEARN=true
# Nach so vielen Tagen ohne Klick gilt ein gezeigter Artikel als "nicht interessant"
FEEDBACK_DAYS=3
# Sterne aus dem Feedreader alle so viele Minuten übernehmen (zusätzlich zum täglichen Lauf, 0 = nur beim Lauf)
STAR_POLL_MINUTES=15

# strict = so wenig über dich an Cloud-Anbieter wie möglich: nur interests.md, keine Beispiele,
# keine Stern-Titel, Klicks nur mit Datum. Einzelne Einstellungen oben/unten haben Vorrang.
PRIVACY=standard

# Protokoll, was an LLM-Anbieter geht (data/llm_audit.jsonl, Auswertung: python -m app privacy-report)
#   on = Anbieter, Modell, Zweck, Zeichen, Artikeltitel, welche Profilteile; full = plus komplette Prompts; off
LLM_AUDIT=on
LLM_AUDIT_DAYS=30
# Plätze pro Digest für einen Zufallsfund knapp unter der Auswahl (gegen die Filterblase)
EXPLORE_SLOTS=1
# Zufallsfund nur, wenn mindestens so viele reguläre Artikel ausgewählt wurden
EXPLORE_MIN_REGULAR=4

# Rate-Limits lernt die App selbst (nach dem ersten "zu viele Anfragen").
# Fester Mindestabstand in Sekunden von Anfang an, nur falls nötig:
LLM_MIN_INTERVAL=0
SUMMARY_PARALLEL=4

# Denkmodus aus (spart Ausgabe-Token) – nur für Modelle, die den Parameter kennen,
# z. B. Mistral Small 4 / Medium 3.5. Andere Modelle: wird automatisch weggelassen.
#REASONING_EFFORT=none

# Was das Auszugs-Modell über dich bekommt: full = Interessen, Beispiele, Sterne; lean = nur interests.md
SUMMARY_PROFILE=full

SCORING_BATCH_SIZE=40
# Wie viele deiner gespeicherten Beispiele mitgeschickt werden (mehr = genauer, teurer)
EXAMPLES_IN_PROMPT=120

# ======================================================================
# Auswahl & Ausgabe
# ======================================================================
# Wie viele Artikel pro Digest: mindestens–höchstens, Zufallsfund eingerechnet.
# An schwachen Tagen wird mit den nächstbesten aufgefüllt (markiert im Digest).
ARTICLES=5-10
# Ab dieser Bewertung (0–10) gilt ein Artikel als gut und kommt rein, solange Platz ist.
MIN_SCORE=6
OUTPUT_LANGUAGE=Deutsch
# Digest nach Themen gruppieren (ein zusätzlicher kurzer Aufruf beim Auszugs-Modell)
GROUP_TOPICS=true
# daily = ein Feed-Eintrag pro Tag mit allen Artikeln
# items = jeder ausgewählte Artikel ist ein eigener Feed-Eintrag
FEED_MODE=daily
FEED_TITLE=Mein Tages-Digest
KEEP_DAYS=30

# ======================================================================
# Zeitplan & Veröffentlichung
# ======================================================================
DIGEST_TIME=06:30
TZ=Europe/Berlin
RUN_ON_START=false
PUBLIC_URL=https://digest.example.org
# Geheimer Pfadteil -> Feed liegt unter PUBLIC_URL/FEED_TOKEN/feed.xml
# Erzeugen z. B. mit:  openssl rand -hex 16
FEED_TOKEN=
