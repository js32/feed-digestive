# ======================================================================
# Quelle: miniflux (native API) | greader (Google-Reader-API)
# ======================================================================
SOURCE=miniflux

# --- Google Reader API: FreshRSS, Inoreader, The Old Reader, BazQux, Miniflux, …
# Basis-URL, unter der /accounts/ClientLogin und /reader/api/0/ liegen:
#   FreshRSS:        https://freshrss.example.de/api/greader.php
#   Miniflux:        https://miniflux.example.de   (Einstellungen → Integrationen → Google Reader)
#   Inoreader:       https://www.inoreader.com     (+ GREADER_APP_ID / GREADER_APP_KEY)
#   The Old Reader:  https://theoldreader.com
#   BazQux:          https://bazqux.com
GREADER_URL=
GREADER_USER=
# API-Passwort (bei FreshRSS im Profil gesondert festlegen, nicht das Login-Passwort)
GREADER_PASSWORD=
GREADER_APP_ID=
GREADER_APP_KEY=
# Optional: nur diese Ordner/Labels (kommagetrennt), sonst alle Artikel
GREADER_LABELS=

# --- Miniflux (native API)
# Basis-URL deiner Miniflux-Instanz (ohne /v1)
MINIFLUX_URL=https://miniflux.example.de
# Miniflux → Einstellungen → API-Schlüssel → Neuen Schlüssel erstellen
MINIFLUX_API_TOKEN=

# Zeitraum für den ersten Lauf (danach: alles seit dem letzten Lauf)
LOOKBACK_HOURS=24
# Obergrenze, wie viele neue Einträge pro Lauf betrachtet werden
MAX_ENTRIES=400
# true = nur ungelesene Einträge berücksichtigen
ONLY_UNREAD=false
# Optional (Miniflux): nur diese Kategorie-IDs / (beide) diese Feed-IDs ausschließen
# Google Reader: Feed-IDs haben die Form feed/https://example.org/rss
CATEGORY_IDS=
EXCLUDE_FEED_IDS=
# Mit Stern markierte Miniflux-Artikel zusätzlich als Interessensignal nutzen
USE_MINIFLUX_STARRED=true

# ======================================================================
# LLM – zwei Stufen: günstiges Modell bewertet alles, gutes Modell schreibt Auszüge
# Anbieter: anthropic | openai | mistral | openrouter | gemini | ollama | custom
#           (SCORING_PROVIDER zusätzlich: none = nur Laya-Wert, siehe unten)
# ======================================================================
SCORING_PROVIDER=anthropic
SCORING_MODEL=claude-haiku-5-5
SUMMARY_PROVIDER=anthropic
SUMMARY_MODEL=claude-sonnet-5-5

# Nur den Key des genutzten Anbieters eintragen
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Ollama auf dem Host (Standard) oder anderswo; Key meist leer
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# Beliebiger OpenAI-kompatibler Endpunkt (LM Studio, vLLM, LiteLLM, IONOS AI …)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Beispiele (z. B. Mistral, in der EU gehostet):
#   SCORING_PROVIDER=mistral   SCORING_MODEL=mistral-small-latest
#   SUMMARY_PROVIDER=mistral   SUMMARY_MODEL=mistral-medium-latest
# Lokal bewerten (Ollama-Container, siehe docker-compose.yml), Auszüge per API:
#   SCORING_PROVIDER=ollama    SCORING_MODEL=qwen3.5:4b
#   OLLAMA_BASE_URL=http://ollama:11434/v1
#   SCORING_BATCH_SIZE=15      EXAMPLES_IN_PROMPT=40
#   SUMMARY_PROVIDER=mistral   SUMMARY_MODEL=mistral-medium-latest
# Zeitlimit pro LLM-Aufruf in Sekunden (Standard: 900 lokal, 120 API)
# LLM_TIMEOUT=900

# ======================================================================
# Optional: lokaler Vorfilter mit Laya (kleines Entscheidungsmodell, läuft auf CPU)
# Siebt alle neuen Artikel vor, nur die besten PREFILTER_KEEP gehen weiter ans LLM.
# Fragen/Gewichte: config/laya_questions.json
# Image dafür bauen mit:  WITH_LAYA=1 docker compose up -d --build
# ======================================================================
PREFILTER=none
# PREFILTER=laya
PREFILTER_KEEP=40
# Mindestwert (0–10) nach Laya, darunter fliegt ein Artikel sofort raus
PREFILTER_MIN=2.0
# multilingual (Deutsch + Englisch, schneller) | english (nur Englisch, etwas genauer)
LAYA_MODEL=multilingual
LAYA_MAX_LEN=1024
LAYA_BATCH_SIZE=8
# Ganz ohne LLM bewerten: SCORING_PROVIDER=none (dann zählt der Laya-Wert, MIN_SCORE ~4)

# ======================================================================
# Lernen aus Klicks und Sternen (alles lokal in data/)
# ======================================================================
# Links im Digest laufen über PUBLIC_URL/FEED_TOKEN/r/<id> und werden gezählt
TRACK_CLICKS=true
# Mit Laya: Gewichte automatisch aus Klicks/Sternen lernen
LEARN=true
# Nach so vielen Tagen ohne Klick gilt ein gezeigter Artikel als "nicht interessant"
FEEDBACK_DAYS=3
# Plätze pro Digest für einen Zufallsfund knapp unter der Auswahl (gegen die Filterblase)
EXPLORE_SLOTS=1

SCORING_BATCH_SIZE=40
# Wie viele deiner gespeicherten Beispiele mitgeschickt werden (mehr = genauer, teurer)
EXAMPLES_IN_PROMPT=120

# ======================================================================
# Auswahl & Ausgabe
# ======================================================================
TOP_N=10
# Mindestwert 0–10; an schwachen Tagen kommen dann eben weniger Artikel
MIN_SCORE=6
OUTPUT_LANGUAGE=Deutsch
# daily = ein Feed-Eintrag pro Tag mit allen Artikeln
# items = jeder ausgewählte Artikel ist ein eigener Feed-Eintrag
FEED_MODE=daily
FEED_TITLE=Mein Tages-Digest
KEEP_DAYS=30

# ======================================================================
# Zeitplan & Veröffentlichung
# ======================================================================
DIGEST_TIME=06:30
TZ=Europe/Berlin
RUN_ON_START=false
PUBLIC_URL=https://digest.example.org
# Geheimer Pfadteil -> Feed liegt unter PUBLIC_URL/FEED_TOKEN/feed.xml
# Erzeugen z. B. mit:  openssl rand -hex 16
FEED_TOKEN=
