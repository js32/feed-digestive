# feed-digestive – Einstellungen
#
# Kopieren nach .env, den Block "ZUM AUSFÜLLEN" unten anpassen, dann: chmod 600 .env
# Änderungen wirken nach  docker compose up -d  (restart reicht nicht, der liest die .env nicht neu).
# In die .env gehören nur Werte, die vom Standard abweichen. Alles andere gilt automatisch.
#
# ======================================================================================
# ALLE OPTIONEN  (Name · Standardwert · was sie tut)
# ======================================================================================
#
# --- Quelle -------------------------------------------------------------------------
#   SOURCE                 miniflux   miniflux (native API) oder greader (Google-Reader-API)
#   MINIFLUX_URL           –          Basis-URL deiner Miniflux-Instanz, ohne /v1
#   MINIFLUX_API_TOKEN     –          Miniflux → Einstellungen → API-Schlüssel
#   GREADER_URL            –          z. B. https://freshrss.example.de/api/greader.php,
#                                     https://www.inoreader.com, https://theoldreader.com
#   GREADER_USER           –          Benutzername für die Google-Reader-API
#   GREADER_PASSWORD       –          API-Passwort (FreshRSS: gesondertes Passwort im Profil)
#   GREADER_APP_ID/_KEY    –          nur Inoreader: App-Zugangsdaten
#   GREADER_LABELS         –          nur diese Ordner/Labels, kommagetrennt (leer = alle)
#   CATEGORY_IDS           –          Miniflux: nur diese Kategorie-IDs (leer = alle)
#   EXCLUDE_FEED_IDS       –          diese Feeds ignorieren (Google Reader: feed/https://…)
#
# --- Welche Artikel in Frage kommen ------------------------------------------------
#   SELECT_FROM            unread     unread = alle Ungelesenen; new = nur seit dem letzten Lauf neue
#   MAX_ENTRIES            400        höchstens so viele Artikel pro Lauf ansehen (neueste zuerst)
#   UNREAD_MAX_AGE_DAYS    30         bei unread: ältere ignorieren (0 = kein Limit)
#   LOOKBACK_HOURS         24         bei new: wie weit der allererste Lauf zurückschaut
#   ONLY_UNREAD            false      bei new: davon nur die ungelesenen
#
# --- Laya-Vorfilter (lokal, nichts verlässt den Server) -----------------------------
#   PREFILTER              none       lokal vorsortieren, nur die besten gehen ans LLM:
#                                     embeddings = schlank (~200 MB, Sekunden; braucht WITH_EMBEDDINGS=1),
#                                     laya = Entscheidungsmodell (~2,5 GB RAM, ~35 s/Artikel auf kleiner CPU)
#   PREFILTER_KEEP         40         so viele der besten Laya-Artikel gehen ans LLM
#   PREFILTER_MIN          2.0        Laya-Wert (0–10), unter dem ein Artikel rausfliegt
#   PREFILTER_PER_TOPIC    2          Mindestplätze je Thema, bevor nach Punkten sortiert wird (0 = aus)
#   PREFILTER_EXPLORE      5          zufällige Artikel unter der Schwelle, die das LLM zur Kontrolle mitbewertet
#   LEARN_FROM_LLM         true       Laya-Gewichte aus den LLM-Bewertungen lernen (ab 30 bewerteten Artikeln)
#   LAYA_MODEL             auto       auto = Englisches Modell für englische Artikel, sonst mehrsprachig;
#                                     multilingual / english = ein Modell für alle (weniger RAM)
#   LAYA_MAX_LEN           1024       so viele Tokens pro Artikel liest Laya (512 = schneller, weniger RAM)
#   LAYA_BATCH_SIZE        8          Artikel pro Rechenschritt (2 = weniger RAM)
#   LAYA_THREADS           0          CPU-Threads (0 = so viele, wie der Container nutzen darf)
#   LAYA_CHUNK             32         Fortschritt loggen und Zwischenstand sichern alle N Artikel
#   LAYA_DEVICE            –          cpu, cuda oder xpu (leer = Laya entscheidet)
#
# --- LLM: Bewertung und Auszüge -----------------------------------------------------
#   SCORING_PROVIDER       anthropic  anthropic, openai, mistral, openrouter, gemini, ollama, custom
#                                     oder none (= Laya-Wert als Bewertung, braucht PREFILTER=laya)
#   SCORING_MODEL          –          z. B. mistral-small-latest
#   SUMMARY_PROVIDER       anthropic  Anbieter für die Auszüge (wie oben, ohne none)
#   SUMMARY_MODEL          –          z. B. mistral-large-latest
#   <ANBIETER>_API_KEY     –          ANTHROPIC_, OPENAI_, MISTRAL_, OPENROUTER_, GEMINI_, CUSTOM_API_KEY
#   <ANBIETER>_BASE_URL    –          anderer Endpunkt, z. B. OLLAMA_BASE_URL=http://ollama:11434/v1
#                                     oder CUSTOM_BASE_URL für LM Studio, vLLM, LiteLLM …
#   REASONING_EFFORT       –          none = Denkmodus aus (spart Tokens, Mistral Small/Medium);
#                                     Modelle ohne diesen Parameter bekommen ihn automatisch nicht
#   SCORING_BATCH_SIZE     40         Artikel pro Bewertungs-Aufruf (10–15 für kleine lokale Modelle)
#   SUMMARY_PARALLEL       4          so viele Auszüge gleichzeitig
#   LLM_MIN_INTERVAL       0          fester Mindestabstand in Sekunden zwischen zwei Aufrufen; meist
#                                     unnötig, die App lernt Rate-Limits selbst nach dem ersten HTTP 429
#   LLM_TIMEOUT            120 / 900  Sekunden pro Aufruf (900 für ollama und custom)
#   OUTPUT_LANGUAGE        Deutsch    Sprache von Titeln, Auszügen und "Warum lesen"
#
# --- Was über dich an das LLM geht --------------------------------------------------
#   PRIVACY                standard   strict = so wenig wie möglich: nur interests.md, keine Beispiele,
#                                     keine Stern-Titel, schlanke Auszüge, Klicks nur mit Datum.
#                                     Einzeln gesetzte Optionen unten haben Vorrang.
#   EXAMPLES_IN_PROMPT     120        so viele Zeilen aus config/examples.txt gehen mit (0 = keine)
#   USE_MINIFLUX_STARRED   true       Titel deiner 30 letzten Sterne mitschicken (lokales Lernen bleibt)
#   SUMMARY_PROFILE        full       full = Auszugs-Modell bekommt Interessen, Beispiele, Sterne;
#                                     lean = nur interests.md (weniger Tokens, Bewertung unverändert)
#   LLM_AUDIT              on         jeden LLM-Aufruf in data/llm_audit.jsonl protokollieren;
#                                     full = mit komplettem Prompt, off = gar nicht
#   LLM_AUDIT_DAYS         30         Protokolleinträge nach so vielen Tagen löschen
#   (In config/interests.md bleibt alles zwischen <!-- local-only --> und <!-- /local-only -->
#    auf dem Server und geht nur an lokale Modelle.)
#
# --- Lokale Embeddings --------------------------------------------------------------
#   EMBEDDINGS             false      true = gleiche Geschichte aus mehreren Quellen nur einmal,
#                                     "ähnlich zu deinem Stern-Artikel"; Image mit WITH_EMBEDDINGS=1
#   EMBEDDING_MODEL        paraphrase-multilingual-MiniLM-L12-v2 (erkennt Geschichten sprachübergreifend)
#   DEDUP_SIMILARITY       0.75       ab dieser Ähnlichkeit (0–1) gelten zwei Artikel als dieselbe Geschichte
#   SIMILAR_MIN            0.55       "ähnlich zu deinem Stern" ab dieser Ähnlichkeit (0 = aus)
#
# --- Auswahl ------------------------------------------------------------------------
#   ARTICLES               –          mindestens–höchstens pro Digest, z. B. 8-10 (Zufallsfund
#                                     eingerechnet); ersetzt TOP_N und MIN_ITEMS
#   MIN_SCORE              6          ab dieser Bewertung (0–10) gilt ein Artikel als gut
#   TOP_N                  10         höchstens so viele Artikel (wenn ARTICLES nicht gesetzt)
#   MIN_ITEMS              5          mindestens so viele, an schwachen Tagen aufgefüllt (wenn ARTICLES
#   MAX_PER_TOPIC          3          höchstens so viele je Thema, freie Plätze zuerst an andere Themen (0 = aus)
#                                     nicht gesetzt; 0 = nie auffüllen)
#   FLOOR_SCORE            3          nie mit Artikeln unter dieser Bewertung auffüllen
#   GROUP_TOPICS           true       Digest in Themengruppen ordnen (ein kurzer Extra-Aufruf)
#   EXPLORE_SLOTS          1          Plätze für einen 🎲 Zufallsfund knapp unter der Auswahl (0 = aus)
#   EXPLORE_MIN_REGULAR    4          Zufallsfund erst ab so vielen regulären Artikeln
#
# --- Lernen aus Klicks und Sternen --------------------------------------------------
#   TRACK_CLICKS           true       Digest-Links über den eigenen Server leiten und Klicks zählen
#   LEARN                  true       mit Laya: Gewichte aus Klicks und Sternen lernen
#   FEEDBACK_DAYS          3          gezeigter Artikel gilt erst nach so vielen Tagen ohne Klick als
#                                     "nicht interessant"
#   STAR_POLL_MINUTES      15         Sterne (und ggf. Angelesenes) so oft übernehmen, zusätzlich zum Lauf (0 = nur beim Lauf)
#   VOTE_LINKS             true       👍 mehr davon / 👎 weniger davon unter jedem Artikel
#   READ_SIGNAL            false      „im Reader gelesen“ als schwaches Signal (nur wenn du nie zum Aufräumen
#                                     als gelesen markierst; braucht FEED_MODE=items)
#   OPEN_PIXEL             off        log = unsichtbares Bild je Artikel, nur messen (opens-report), zählt nicht
#
# --- Ausgabe-Feed -------------------------------------------------------------------
#   PUBLIC_URL             –          öffentliche Adresse, wie dein Feedreader sie sieht
#   FEED_TOKEN             –          geheimer Pfad: PUBLIC_URL/FEED_TOKEN/feed.xml (openssl rand -hex 16)
#   FEED_MODE              daily      daily = ein Eintrag pro Tag; items = ein Eintrag pro Artikel
#                                     (nur mit items geht READ_SIGNAL)
#   FEED_TITLE             Mein Tages-Digest
#   KEEP_DAYS              30         so lange bleiben Digests im Feed
#
# --- Zeitplan -----------------------------------------------------------------------
#   DIGEST_TIME            06:30      Uhrzeit des täglichen Laufs
#   TZ                     Europe/Berlin
#   RUN_ON_START           false      zusätzlich direkt nach dem Containerstart laufen
#
# --- Container (wirken beim Bauen bzw. in docker-compose.yml) -----------------------
#   WITH_LAYA              1          Image mit Laya bauen (PyTorch, ~1 GB größer); 0 = schlank
#   WITH_EMBEDDINGS        1          Image mit lokalen Embeddings bauen
#   DIGEST_MEM_LIMIT       3g         Speichergrenze des Containers
#   DIGEST_CPUS            2          CPU-Grenze des Containers
#   OLLAMA_MEM_LIMIT       6g         Speichergrenze des optionalen Ollama-Containers
#   HTTP_PORT, DATA_DIR, CONFIG_DIR   setzt der Container selbst, nicht ändern
#
# Ausführlich, auf Englisch: README.md, Abschnitt "Settings reference".
# ======================================================================================


# ======================================================================================
# ZUM AUSFÜLLEN
# ======================================================================================

# --- Veröffentlichung
PUBLIC_URL=https://digest.example.org
# openssl rand -hex 16
FEED_TOKEN=

# --- Feedreader (Miniflux; für FreshRSS & Co. stattdessen SOURCE=greader und GREADER_*)
MINIFLUX_URL=https://miniflux.example.org
MINIFLUX_API_TOKEN=

# --- LLM: günstiges Modell bewertet, gutes Modell schreibt die Auszüge
SCORING_PROVIDER=mistral
SCORING_MODEL=mistral-small-latest
SUMMARY_PROVIDER=mistral
SUMMARY_MODEL=mistral-medium-latest
MISTRAL_API_KEY=

# --- Häufig angepasst
ARTICLES=5-10
MIN_SCORE=6
FEED_MODE=daily
DIGEST_TIME=06:30
TZ=Europe/Berlin

# --- Empfohlen: lokal vorfiltern und Dubletten erkennen
PREFILTER=laya
EMBEDDINGS=true
